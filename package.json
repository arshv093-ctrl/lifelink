{
  "name": "lifelink-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "LifeLink - A Tamper-Evident, Concurrency-Safe Blood and Organ Allocation Platform | Arsh Vardhan Singh (24BCE2119)",
  "type": "module",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "test": "node --experimental-strip-types backend/dist/suite.test.js",
    "test:build": "esbuild backend/src/tests/suite.test.ts --bundle --platform=node --format=esm --target=node22 --outfile=backend/dist/suite.test.js && node backend/dist/suite.test.js",
    "build:backend": "esbuild backend/src/server.ts --bundle --platform=node --format=esm --target=node22 --outfile=backend/dist/server.js",
    "build:frontend": "cd frontend && npm run build",
    "build": "npm run build:backend && npm run build:frontend && cp -rf frontend/dist ./dist",
    "start": "node backend/dist/server.js",
    "dev:backend": "node --watch backend/dist/server.js",
    "dev:frontend": "cd frontend && npm run dev"
  },
  "devDependencies": {
    "esbuild": "^0.21.5"
  },
  "keywords": [
    "lifelink",
    "postgresql",
    "concurrency",
    "audit-ledger",
    "merkle-tree",
    "dbms",
    "24BCE2119",
    "vit"
  ],
  "author": "Arsh Vardhan Singh (24BCE2119)"
}
