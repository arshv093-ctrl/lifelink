# ==============================================================================
# LifeLink Backend Dockerfile
# Student: Arsh Vardhan Singh (24BCE2119) | VIT DBMS Lab
# ==============================================================================
FROM node:22-alpine AS builder

WORKDIR /app
COPY package*.json ./
COPY backend/package*.json ./backend/
COPY backend ./backend

# Build backend bundle with esbuild
RUN npx esbuild backend/src/server.ts --bundle --platform=node --format=esm --target=node22 --outfile=backend/dist/server.js

# Production Runtime
FROM node:22-alpine AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV PORT=4000

COPY --from=builder /app/backend/dist ./backend/dist
COPY package.json ./

EXPOSE 4000
CMD ["node", "backend/dist/server.js"]
