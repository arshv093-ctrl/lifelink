# ==============================================================================
# LIFELINK CONFIGURATION ENVIRONMENT VARIABLES (.env.example)
# Student: Arsh Vardhan Singh (24BCE2119) | School of CSE, VIT
# Course Context: Database Systems Lab
# ==============================================================================

# Node Environment
NODE_ENV=development
PORT=4000
FRONTEND_PORT=3000

# PostgreSQL 16 Primary Database Connection String
DATABASE_URL="postgresql://lifelink_user:ChangeMeSecure2026!@localhost:5432/lifelink_db?schema=public"

# Database Connection Pool Settings
DB_POOL_MIN=2
DB_POOL_MAX=20
DB_TIMEOUT_MS=5000

# Authentication & Session Security
JWT_SECRET="lifelink-jwt-secret-vit-24bce2119-arshvardhansingh"
JWT_EXPIRES_IN="2h"

# Break-Glass Emergency Access Constraints
EMERGENCY_ACCESS_MAX_MINUTES=30
EMERGENCY_DEFAULT_DURATION_MINUTES=15

# Query Performance Telemetry Thresholds
TELEMETRY_LATENCY_THRESHOLD_MS=15
TELEMETRY_MAX_SLOW_QUERIES=50

# Optional Google OAuth Credentials (Leave empty for secure local auth mode)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# External Merkle Root Checkpoint Anchor (Optional external verification ref)
EXTERNAL_CHECKPOINT_ANCHOR_URL=""
